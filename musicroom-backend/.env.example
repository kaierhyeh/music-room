DATABASE_URL=postgres://musicroom:musicroom@localhost:5432/musicroom?sslmode=disable
JWT_SECRET=change-me-in-production

PORT=8080
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

DEEZER_API_BASE=https://api.deezer.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
APP_REDIRECT_URL=musicroom://auth

NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Rate limiting. Leave unset in normal use — these exist so a load test run from a single machine can measure the server instead of the limiter. A value that is absent, zero or unparseable falls back to the default; only RATE_LIMIT_DISABLED turns the limiters off, and doing so logs a warning at startup.
# RATE_LIMIT_RPS=20
# RATE_LIMIT_AUTH_PER_MIN=10
# RATE_LIMIT_AUTH_BURST=3
# RATE_LIMIT_DISABLED=true
